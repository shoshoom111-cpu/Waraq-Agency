rules_version = '2';

// قاعدة بيانات مشروع الوكالة (waraq-agency) غير مستخدمة.
// طلبات الموقع تُحفظ في قاعدة لوحة المسوقين (book-campaigns).
// لذلك هذه القاعدة مقفلة بالكامل: لا أحد يقرأ ولا يكتب.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
